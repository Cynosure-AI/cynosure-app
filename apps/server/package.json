{
  "name": "cynosure-server",
  "version": "1.0.0",
  "description": "Cynosure server – LLM orchestrator with tools, agents, and memory",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck:test": "tsc --project tsconfig.test.json",
    "memory:eval": "tsx src/scripts/memory-eval/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^9.1.3",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@fastify/websocket": "^11.2.0",
    "@google/genai": "^1.44.0",
    "@lancedb/lancedb": "^0.33.0",
    "@langchain/textsplitters": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@slack/bolt": "^4.6.0",
    "@slack/web-api": "^7.15.0",
    "adm-zip": "^0.5.16",
    "ajv": "^8.18.0",
    "apache-arrow": "^18.1.0",
    "archiver": "^7.0.1",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "cron-parser": "^5.5.0",
    "diff": "^9.0.0",
    "discord.js": "^14.25.1",
    "dotenv": "^16.5.0",
    "fastify": "^5.8.2",
    "marked": "^17.0.6",
    "nanoid": "^5.1.6",
    "node-cron": "^4.2.1",
    "officeparser": "^7.1.0",
    "openai": "^6.27.0",
    "sharp": "^0.34.5",
    "unpdf": "^1.8.1",
    "unzipper": "^0.12.5",
    "ws": "^8.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^7.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/chokidar": "^2.1.7",
    "@types/node": "^22.19.1",
    "@types/node-cron": "^3.0.11",
    "@types/unzipper": "^0.10.11",
    "@types/ws": "^8.18.1",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
