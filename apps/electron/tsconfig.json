{
    "extends": "@electron-toolkit/tsconfig/tsconfig.json",
    "compilerOptions": {
        "composite": true,
        "types": [
            "electron-vite/node"
        ],
        "paths": {
            "@main/*": [
                "./src/main/*"
            ],
            "@preload/*": [
                "./src/preload/*"
            ]
        }
    },
    "include": [
        "src/main/**/*",
        "src/preload/**/*"
    ]
}
