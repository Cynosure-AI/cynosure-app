{
  "name": "cynosure",
  "version": "2.0.0",
  "private": true,
  "description": "Cynosure monorepo — server, web UI, and Electron desktop app",
  "scripts": {
    "dev:server": "pnpm --filter cynosure-server dev",
    "dev:web": "pnpm --filter cynosure-web dev",
    "dev:electron": "pnpm --filter cynosure-desktop dev",
    "dev": "concurrently --names server,web --prefix-colors blue,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "build:server": "pnpm run build:web && pnpm --filter cynosure-server build",
    "build:web": "pnpm --filter cynosure-web build",
    "build:electron": "pnpm --filter cynosure-desktop build",
    "build": "pnpm run build:web && pnpm --filter cynosure-server build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:web",
    "test:unit": "pnpm --filter cynosure-server test:unit",
    "test:integration": "pnpm --filter cynosure-server test:integration",
    "test:web": "pnpm --filter cynosure-web test",
    "test:coverage": "pnpm --filter cynosure-server test:coverage && pnpm --filter cynosure-web test:coverage",
    "test:typecheck": "pnpm --filter cynosure-server typecheck:test && pnpm --filter cynosure-web exec vue-tsc --noEmit",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "package:electron": "pnpm --filter cynosure-desktop package",
    "package:linux": "pnpm --filter cynosure-desktop package:linux",
    "package:win": "pnpm --filter cynosure-desktop package:win",
    "package:mac": "pnpm --filter cynosure-desktop package:mac"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.1.2",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "electron-winstaller",
      "esbuild",
      "onnxruntime-node",
      "protobufjs",
      "sharp"
    ]
  }
}
