{
  "name": "cynosure",
  "version": "1.0.0",
  "private": true,
  "description": "Cynosure monorepo — server, web UI, and Electron desktop app",
  "scripts": {
    "dev:server": "pnpm --filter cynosure-server dev",
    "dev:web": "pnpm --filter cynosure-web dev",
    "dev:electron": "pnpm --filter cynosure-desktop dev",
    "dev": "pnpm --filter cynosure-server dev & pnpm --filter cynosure-web dev",
    "build:server": "pnpm run build:web && pnpm --filter cynosure-server build",
    "build:web": "pnpm --filter cynosure-web build",
    "build:electron": "pnpm --filter cynosure-desktop build",
    "build": "pnpm run build:web && pnpm --filter cynosure-server build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "package:electron": "pnpm --filter cynosure-desktop package",
    "package:linux": "pnpm --filter cynosure-desktop package:linux",
    "package:win": "pnpm --filter cynosure-desktop package:win",
    "package:mac": "pnpm --filter cynosure-desktop package:mac"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "electron-winstaller",
      "esbuild",
      "onnxruntime-node",
      "protobufjs",
      "sharp"
    ]
  }
}
